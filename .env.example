# Contact form submission endpoint.
# When set, the contact form POSTs JSON to this URL.
# Works out of the box with Formspree (https://formspree.io) or Web3Forms (https://web3forms.com),
# or any custom backend / serverless function that accepts a JSON POST.
#
# Examples:
#   VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-form-id
#   VITE_CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit
#
# For Web3Forms you also need the access key below (it is a PUBLIC key, safe for the client):
# VITE_WEB3FORMS_KEY=your-public-access-key
VITE_CONTACT_FORM_ENDPOINT=
VITE_WEB3FORMS_KEY=
